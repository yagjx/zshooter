    <line x1="256" y1="36" x2="256" y2="92"/>
    <line x1="256" y1="420" x2="256" y2="476"/>
    <line x1="36" y1="256" x2="92" y2="256"/>
    <line x1="420" y1="256" x2="476" y2="256"/>
  </g>
  <rect x="181" y="181" width="150" height="150" rx="34" fill="#5fae3f"/>
  <rect x="181" y="329" width="150" height="34" rx="0" fill="#3e7a2a"/>
  <rect x="196" y="222" width="28" height="28" fill="#101418"/>
